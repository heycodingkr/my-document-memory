# Copy to .env, or let scripts/dev.mjs generate a private local token.
DMEM_TOKEN=replace-with-at-least-16-random-characters
DMEM_ADDR=127.0.0.1:3847
DMEM_DATABASE=data/dmem.sqlite3
DMEM_WEB_ORIGIN=http://127.0.0.1:5174
DMEM_WEB_DIR=web/dist
# Optional email-link sign-in: use a Resend key and a verified sender domain.
# DMEM_RESEND_API_KEY=
# DMEM_EMAIL_FROM=My Document Memory <help@mydocumentmemory.com>
# DMEM_AUTH_SECRET=replace-with-a-stable-random-secret-of-at-least-32-characters
# Optional administrator email-link access; only these normalized addresses may review contributions.
# DMEM_ADMIN_EMAILS=operator@example.test,reviewer@example.test
# Optional account credentials are read from ignored credentials/ files by default:
# resend-api-key, auth-secret (>=32 characters), admin-token (>=32, distinct from DMEM_TOKEN).
# Environment overrides: DMEM_RESEND_API_KEY, DMEM_AUTH_SECRET, DMEM_ADMIN_TOKEN, DMEM_ADMIN_EMAILS.
# DMEM_EMAIL_FROM=My Document Memory <help@mydocumentmemory.com>
# Allowed administrator email addresses (exact normalized matches; empty disables admin login).
# DMEM_ADMIN_EMAILS=reviewer@example.com,second@example.com
# In production use DMEM_WEB_ORIGIN=https://mydocumentmemory.com (Secure cookies).
# Production behind Caddy uses DMEM_ADDR=127.0.0.1:3848 on the server itself.
# Hosted CLI/MCP clients use DMEM_URL=https://api.mydocumentmemory.com instead of starting a server.
# Optional web search (server only). URL preview/import works without this key.
# DMEM_BRAVE_API_KEY=
# Owned Arise tab clips: same private secret (>=32 characters) on server and browser-mcp adapter.
# Supply through private environment settings; never MCP arguments or committed configuration.
# DMEM_CAPTURE_SECRET=
